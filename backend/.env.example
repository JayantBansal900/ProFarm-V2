PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# Optional on Render: it defaults to the service address.
FRONTEND_ORIGIN="http://localhost:5173"
OPENWEATHER_API_KEY=""
NASA_POWER_BASE_URL="https://power.larc.nasa.gov"
DATA_GOV_IN_API_KEY=""

# Two-step verification: encrypts authenticator secrets at rest.
# Required in production (32+ random characters, e.g. `openssl rand -base64 48`).
MFA_ENCRYPTION_KEY=

# What "today" means for due dates and overdue tasks (IANA name). Defaults to Asia/Kolkata.
APP_TIMEZONE=Asia/Kolkata

# Reverse-proxy hops to trust when reading visitor IPs (rate limiting). Defaults to 1 in
# production (hosting platforms put one proxy in front) and 0 in development.
# TRUST_PROXY=1

# Free hosting wipes the database on restart. SEED_DEMO=true recreates a demo farmer
# (demo.farmer@example.com) with sample farms when the database has no accounts.
# SEED_DEMO=false
# DEMO_PASSWORD=ProFarm-Demo-2026
